import * as ts from "typescript";
import { z } from "zod";
import { globalToolRegistry } from "../agent/tools/registry";

export interface PatchOptions {
  filePath?: string;
  validateAst?: boolean;
  fuzzyMatchThreshold?: number;
}

export interface PatchResult {
  success: boolean;
  patchedCode?: string;
  matchedLine?: number;
  replacedLinesCount?: number;
  error?: string;
  astErrors?: string[];
}

/**
 * Precision Search-and-Replace Block Diff Engine
 * Performs exact or fuzzy block matching and optionally validates AST syntax before committing.
 */
export function applyBlockPatch(
  originalCode: string,
  searchBlock: string,
  replaceBlock: string,
  options: PatchOptions = {}
): PatchResult {
  const validateAst = options.validateAst ?? true;
  const filePath = options.filePath || "file.ts";

  // Normalize line endings to LF
  const normOriginal = originalCode.replace(/\r\n/g, "\n");
  const normSearch = searchBlock.replace(/\r\n/g, "\n").trim();
  const normReplace = replaceBlock.replace(/\r\n/g, "\n");

  if (!normSearch) {
    return {
      success: false,
      error: "Search block cannot be empty.",
    };
  }

  // 1. Attempt Exact Block Match
  let matchIndex = normOriginal.indexOf(normSearch);
  let matchedString = normSearch;

  // 2. Fallback to Fuzzy Line-by-Line Match if exact match fails
  if (matchIndex === -1) {
    const fuzzyMatch = performFuzzyBlockSearch(normOriginal, normSearch);
    if (fuzzyMatch) {
      matchIndex = fuzzyMatch.index;
      matchedString = fuzzyMatch.matchedText;
    }
  }

  if (matchIndex === -1) {
    return {
      success: false,
      error: `Search block not found in target file. Ensure exact line indentation or unique context lines.`,
    };
  }

  // Calculate line number where match starts
  const lineBeforeMatch = normOriginal.slice(0, matchIndex).split("\n").length;
  const replacedLinesCount = matchedString.split("\n").length;

  // Perform substitution
  const patchedCode =
    normOriginal.slice(0, matchIndex) +
    normReplace +
    normOriginal.slice(matchIndex + matchedString.length);

  // 3. Optional AST Syntactic Diagnostics Check
  if (validateAst && isTypeScriptOrJS(filePath)) {
    const astErrors = checkAstSyntaxErrors(patchedCode, filePath);
    if (astErrors.length > 0) {
      return {
        success: false,
        error: `AST syntax validation failed after applying patch: ${astErrors[0]}`,
        astErrors,
      };
    }
  }

  return {
    success: true,
    patchedCode,
    matchedLine: lineBeforeMatch,
    replacedLinesCount,
  };
}

/**
 * Fuzzy search that matches consecutive lines ignoring leading/trailing whitespace.
 */
function performFuzzyBlockSearch(
  source: string,
  search: string
): { index: number; matchedText: string } | null {
  const sourceLines = source.split("\n");
  const searchLines = search.split("\n").map((l) => l.trim());

  if (searchLines.length === 0) return null;

  for (let i = 0; i <= sourceLines.length - searchLines.length; i++) {
    let match = true;
    for (let j = 0; j < searchLines.length; j++) {
      if (sourceLines[i + j].trim() !== searchLines[j]) {
        match = false;
        break;
      }
    }

    if (match) {
      // Reconstruct original text matching this range
      const matchedLines = sourceLines.slice(i, i + searchLines.length);
      const matchedText = matchedLines.join("\n");

      // Calculate character index in source string
      const charIndex = sourceLines.slice(0, i).join("\n").length + (i > 0 ? 1 : 0);

      return { index: charIndex, matchedText };
    }
  }

  return null;
}

/**
 * Parse TypeScript/JavaScript code into AST and inspect for syntax errors using TS Compiler API.
 */
function checkAstSyntaxErrors(code: string, fileName: string): string[] {
  const scriptTarget = ts.ScriptTarget.Latest;
  const sourceFile = ts.createSourceFile(
    fileName,
    code,
    scriptTarget,
    true, // setParentNodes
    fileName.endsWith(".tsx") || fileName.endsWith(".jsx") ? ts.ScriptKind.TSX : ts.ScriptKind.TS
  );

  // Read syntactic parse diagnostics from source file parser
  const diagnostics = (sourceFile as any).parseDiagnostics || [];

  return diagnostics.map((d: ts.Diagnostic) => {
    const message = ts.flattenDiagnosticMessageText(d.messageText, "\n");
    if (d.file && d.start !== undefined) {
      const { line, character } = d.file.getLineAndCharacterOfPosition(d.start);
      return `Line ${line + 1}, Col ${character + 1}: ${message}`;
    }
    return message;
  });
}

function isTypeScriptOrJS(fileName: string): boolean {
  return /\.(js|jsx|ts|tsx|mjs|cjs)$/i.test(fileName);
}

// ==========================================
// Register Tool in Agent Tool Registry
// ==========================================

globalToolRegistry.registerTool({
  name: "patch_file",
  description:
    "Apply a precision search-and-replace block patch to a source file with AST syntax verification.",
  parameters: z.object({
    filePath: z.string().describe("Target file path relative to workspace root."),
    searchBlock: z.string().describe("Exact code snippet or context lines to search for."),
    replaceBlock: z.string().describe("New code snippet to replace the search block with."),
    fileContent: z
      .string()
      .optional()
      .describe("Full existing content of the file if applying locally."),
  }),
  execute: async (args) => {
    if (!args.fileContent) {
      return {
        success: false,
        output: "File content required to execute local block patch.",
        error: "MISSING_FILE_CONTENT",
      };
    }

    const patchResult = applyBlockPatch(args.fileContent, args.searchBlock, args.replaceBlock, {
      filePath: args.filePath,
      validateAst: true,
    });

    if (!patchResult.success) {
      return {
        success: false,
        output: `Patch failed for ${args.filePath}: ${patchResult.error}`,
        error: "PATCH_FAILED",
        data: { astErrors: patchResult.astErrors },
      };
    }

    return {
      success: true,
      output: `Successfully patched ${args.filePath} starting at line ${patchResult.matchedLine} (${patchResult.replacedLinesCount} lines replaced). AST syntax validated OK.`,
      data: {
        patchedCode: patchResult.patchedCode,
        matchedLine: patchResult.matchedLine,
        replacedLinesCount: patchResult.replacedLinesCount,
      },
    };
  },
});